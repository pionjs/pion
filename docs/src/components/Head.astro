---
import Default from '@astrojs/starlight/components/Head.astro';
import '@fontsource/instrument-sans/400.css';
import '@fontsource/instrument-sans/600.css';
---
<Default />
<meta property="og:image" content="https://pionjs.com/og.png" />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content="PionJS — Hooks for Web Components" />
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:image" content="https://pionjs.com/og.png" />
<meta name="twitter:title" content="PionJS — Hooks for Web Components" />
<meta name="twitter:description" content="React-like hooks for Web Components. Lightweight, standards-based, framework-agnostic." />
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<link rel="icon" type="image/png" href="/favicon.png" />
<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
<script is:inline type="application/ld+json" set:html={JSON.stringify({
  "@context": "https://schema.org",
  "@type": "WebSite",
  name: "PionJS",
  url: "https://pionjs.com",
  description: "Hooks for Web Components",
})} />
<script defer src="https://cloud.umami.is/script.js" data-website-id="8bd77f5a-a2da-4856-8963-3b95c7ce1302"></script>
